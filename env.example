# O CLI lê variáveis de ambiente do Windows (não lê arquivo .env).
# PowerShell (sessão atual):
#   $env:STACKSPOT_CLIENT_ID = "<client_id>"
#   $env:STACKSPOT_CLIENT_SECRET = "<client_secret>"
# Persistente para a conta de serviço que roda a tarefa agendada:
#   setx STACKSPOT_CLIENT_ID "<client_id>"
#   setx STACKSPOT_CLIENT_SECRET "<client_secret>"
# Prefira um cofre de segredos corporativo; nunca versione credenciais.
